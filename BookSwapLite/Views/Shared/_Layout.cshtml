<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookSwapLite</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="bg-light">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">

                <a class="navbar-brand fw-bold"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">
                    📚 BookSwapLite
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Book"
                                   asp-action="Index">
                                Books
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-area=""
                                   asp-controller="SwapRequest"
                                   asp-action="MyRequests">
                                Swap Requests
                            </a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                       asp-controller="Favorite"
                                       asp-action="MyFavorites">
                                    Favorites
                                </a>
                            </li>
                        }

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                       asp-area="Identity"
                                       asp-page="/Account/Manage/Index">
                                    My Profile
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold border border-warning rounded px-2 ms-2"
                                       asp-area="Admin"
                                       asp-controller="AdminBook"
                                       asp-action="Index">
                                    Admin Panel
                                </a>
                            </li>
                        }

                    </ul>

                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    <main class="container mt-4">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info text-center">
                @TempData["InfoMessage"]
            </div>
        }

        @RenderBody()
    </main>

    <footer class="text-center mt-5 py-4 border-top text-muted">
        <p class="mb-0">
            © 2026 BookSwapLite — Swap books with others 📖
        </p>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>