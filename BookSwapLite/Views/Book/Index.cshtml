@model IEnumerable<BookSwap.Core.ViewModels.Books.BookIndexViewModel>
@using System.Security.Claims
@using BookSwap.Data.Models

@{
    ViewData["Title"] = "All Books";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">📚 Available Books</h2>
    <a asp-action="Create" class="btn btn-success">
        ➕ Add New Book
    </a>
</div>

<form method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchTerm" class="form-control"
               placeholder="Search by title or author..."
               value="@ViewBag.SearchTerm" />

        <button class="btn btn-primary">Search</button>

        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No books available yet. Add the first one!
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">

        @foreach (var book in Model)
        {
            <div class="col">
                <div class="card shadow-sm h-100">

                    <div class="card-body">
                        <h5 class="card-title fw-bold">
                            @book.Title
                        </h5>

                        <p class="card-text text-muted">
                            ✍️ Author: @book.Author
                        </p>
                    </div>

                    <div class="card-footer bg-white border-0">

                        <div class="d-flex flex-wrap gap-2">

                            <a asp-action="Details"
                                   asp-route-id="@book.Id"
                                   class="btn btn-outline-primary btn-sm">
                                Details
                            </a>

                            @if (userId == book.OwnerId)
                            {
                                <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-outline-warning btn-sm">
                                    Edit
                                </a>

                                <form asp-action="Delete" asp-route-id="@book.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('Are you sure you want to delete this book?');">
                                        Delete
                                    </button>
                                </form>
                            }
                            else if (!string.IsNullOrEmpty(userId))
                            {
                                <form asp-controller="SwapRequest" asp-action="Create" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookId" value="@book.Id" />
                                    <button type="submit" class="btn btn-primary btn-sm">
                                        🔄 Request Swap
                                    </button>
                                </form>
                            }

                        </div>

                    </div>
                </div>
            </div>
        }

    </div>
}