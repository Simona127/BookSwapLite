@using BookSwap.Core.ViewModels.Books
@model BookDetailsViewModel

@{
    ViewData["Title"] = "Book Details";
}

<div class="container mt-4">
    <div class="card shadow-sm p-4">

        <h3 class="fw-bold">@Model.Title</h3>
        <p class="text-muted">✍️ @Model.Author</p>

        <hr />

        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Condition:</strong> @Model.Condition</p>

        <div class="mt-3 d-flex gap-2 flex-wrap">

            <a asp-action="Index" class="btn btn-outline-secondary">
                ⬅ Back
            </a>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                ✏️ Edit
            </a>

            <form asp-controller="Favorite" asp-action="Add" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookId" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-danger">
                    ❤️ Add to Favorites
                </button>
            </form>

            <form asp-controller="SwapRequest" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookId" value="@Model.Id" />
                <button type="submit" class="btn btn-success">
                    🔄 Request Swap
                </button>
            </form>

            @if (User.Identity.IsAuthenticated &&
                 User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value != Model.OwnerId)
            {
                <a asp-controller="Review"
                       asp-action="Add"
                       asp-route-userId="@Model.OwnerId"
                       class="btn btn-outline-primary">
                    ⭐ Add Review
                </a>
            }

        </div>
    </div>
</div>