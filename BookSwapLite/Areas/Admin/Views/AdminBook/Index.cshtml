@using BookSwap.Web.ViewModels.Books
@model IEnumerable<BookIndexViewModel>

<div class="container mt-5">

    <h2 class="text-center mb-4">📚 Admin Panel - Books</h2>

    <div class="row">

        @foreach (var book in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card shadow h-100">

                    <div class="card-body d-flex flex-column">

                        <h5 class="fw-bold">@book.Title</h5>
                        <p class="text-muted">✍️ @book.Author</p>

                        <div class="mt-auto d-flex justify-content-between">

                            <a asp-action="Details" asp-route-id="@book.Id"
                                   class="btn btn-info btn-sm">
                                Details
                            </a>

                            <a asp-action="Edit" asp-route-id="@book.Id"
                                   class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <form asp-action="Delete" asp-route-id="@book.Id"
                                  method="post">
                                <button class="btn btn-danger btn-sm">
                                    Delete
                                </button>
                            </form>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
</div>