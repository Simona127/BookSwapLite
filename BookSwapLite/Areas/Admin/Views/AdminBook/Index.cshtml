@using BookSwap.Core.ViewModels.Books
@model IEnumerable<BookIndexViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center mt-3" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show text-center mt-3" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-5">
    <h2 class="text-center mb-5 fw-bold">📚 Admin Panel</h2>

    <div class="row g-4">
        @foreach (var book in Model)
        {
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body d-flex flex-column text-center">

                        <h5 class="fw-bold">@book.Title</h5>
                        <p class="text-muted mb-3">✍️ @book.Author</p>

                        <div class="mt-auto d-grid gap-2">

                            <a asp-area="Admin"
                                   asp-controller="AdminBook"
                                   asp-action="Details"
                                   asp-route-id="@book.Id"
                                   class="btn btn-outline-primary">
                                🔍 Details
                            </a>

                            <a asp-area="Admin"
                                   asp-controller="AdminBook"
                                   asp-action="Edit"
                                   asp-route-id="@book.Id"
                                   class="btn btn-outline-warning">
                                ✏ Edit
                            </a>

                            <form asp-area="Admin"
                                  asp-controller="AdminBook"
                                  asp-action="DeleteConfirmed"
                                  asp-route-id="@book.Id"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this book?');">
                                
                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-outline-danger w-100">
                                    🗑 Delete
                                </button>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>