@using BookSwap.Core.ViewModels.Books
@model BookDetailsViewModel

@{
    ViewData["Title"] = "Book Details";
}

<div class="container mt-5">
    <div class="card shadow-lg">

        <div class="card-header bg-info text-white">
            <h3 class="mb-0">📖 Book Details</h3>
        </div>

        <div class="card-body">

            <h4 class="fw-bold">@Model.Title</h4>
            <p class="text-muted mb-3">✍️ @Model.Author</p>

            <hr />

            <p><strong>Genre:</strong> @Model.Genre</p>
            <p><strong>Condition:</strong> @Model.Condition</p>

            <hr />

            <p><strong>Description:</strong></p>
            <p>@Model.Description</p>

        </div>

        <div class="card-footer d-flex justify-content-between">

            <a asp-action="Index" class="btn btn-secondary">
                ⬅ Back
            </a>

            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                    ✏️ Edit
                </a>

                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                    🗑 Delete
                </a>
            </div>

        </div>
    </div>
</div>