@using BookSwap.Web.ViewModels.Books
@model BookDetailsViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 text-center">
    <div class="card shadow border-0 p-4">

        <h2 class="text-danger mb-3">⚠ Delete Book</h2>

        <div class="alert alert-danger">
            Are you sure you want to delete this book?
        </div>

        <h4 class="fw-bold">@Model.Title</h4>
        <p class="text-muted">@Model.Description</p>

        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()

            <div class="d-flex justify-content-center gap-3 mt-4">
                <button type="submit" class="btn btn-danger px-4">
                    Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary px-4">
                    Cancel
                </a>
            </div>
        </form>

    </div>
</div>